# Copia este archivo a .env.local y rellena los valores.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API (console.anthropic.com → API Keys). Solo servidor.
ANTHROPIC_API_KEY=
# Modelo del asistente (opcional). Por defecto claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# URL pública para los enlaces de invitación (opcional; si falta se usa el host de la petición).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Límites del asistente por usuario (opcional).
ASSISTANT_LIMIT_PER_MINUTE=8
ASSISTANT_LIMIT_PER_DAY=300

# Solo para los tests e2e completos contra un proyecto Supabase de pruebas (opcional).
E2E_EMAIL=
E2E_PASSWORD=
