# Copia este archivo a .env.local y rellena los valores.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA del asistente: API compatible con OpenAI, por defecto NVIDIA (build.nvidia.com → Get API Key). Solo servidor.
NVIDIA_API_KEY=
# Opcionales:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=openai/gpt-oss-20b
# Respaldo si el principal no responde en LLM_FIRST_BYTE_TIMEOUT_MS o da 429/5xx (vacío = sin respaldo).
# LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_FIRST_BYTE_TIMEOUT_MS=20000

# URL pública para los enlaces de invitación (opcional; si falta se usa el host de la petición).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Límites del asistente por usuario (opcional).
ASSISTANT_LIMIT_PER_MINUTE=8
ASSISTANT_LIMIT_PER_DAY=300

# Solo para los tests e2e completos contra un proyecto Supabase de pruebas (opcional).
E2E_EMAIL=
E2E_PASSWORD=
